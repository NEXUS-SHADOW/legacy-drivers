+static void
+lx5000_initialize_device_procs(gx_device *dev)
+{
+    /* Standard printer defaults: open, close, output_page, page device, ... */
+    gdev_prn_initialize_device_procs(dev);
+
+    /* The driver's own procedures (formerly passed to lx5000_proctab) */
+    set_dev_proc(dev, get_params, lx5000_get_params);
+    set_dev_proc(dev, put_params, lx5000_put_params);
+    set_dev_proc(dev, map_color_rgb, lx5000_map_color_rgb);
+    set_dev_proc(dev, map_cmyk_color, lx5000_map_cmyk_color);
+
+    /* Colour (CMYK, 1 bit per component) is the default mode;
+       lx5000_put_params switches these for black-only mode */
+    set_dev_proc(dev, encode_color, lx5000_map_cmyk_color);
+    set_dev_proc(dev, decode_color, cmyk_1bit_map_color_cmyk);
+}
 
